# String de conexão do Postgres. NUNCA commitar o arquivo .env preenchido.
#
# Supabase: Project Settings -> Database -> Connection string -> URI
#   use a porta 6543 (pooler) para cargas longas
# Neon:     Dashboard -> Connection Details
# Local:    postgresql://postgres:postgres@localhost:5432/mirante
MIRANTE_DATABASE_URL=postgresql://user:senha@host:5432/postgres

# Identificação honesta nas requisições. Várias fontes públicas devolvem 403
# para user-agent de biblioteca; identificar o projeto costuma resolver.
MIRANTE_USER_AGENT=mirante/0.1 (projeto de transparência; contato: SEU_EMAIL)
